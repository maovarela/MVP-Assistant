# ─── LLM provider chain (Gemini → Groq → DeepSeek pattern) ───────────────────
# Primary: Gemini 2.0 Flash (free tier — 1500 req/day, 1M tokens/min)
LLM_API_KEY=AIza...
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Fallback 1: Groq (free, llama-3.3-70b — fast)
LLM_FALLBACK_1_KEY=gsk_...
LLM_FALLBACK_1_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_1_BASE_URL=https://api.groq.com/openai/v1

# Fallback 2: DeepSeek (Chinese, cheap)
LLM_FALLBACK_2_KEY=sk-...
LLM_FALLBACK_2_MODEL=deepseek-chat
LLM_FALLBACK_2_BASE_URL=https://api.deepseek.com/v1

# ─── Telegram bot (separate from Runaldo) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_WEBHOOK_SECRET=long-random-string-for-webhook-signing

# ─── Gmail (dedicated account: mauricio.varela.ai@gmail.com) ──────────────────
# Generate app password at https://myaccount.google.com/apppasswords
GMAIL_USER=mauricio.varela.ai@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# ─── Storage ──────────────────────────────────────────────────────────────────
# Locally use ./data/pm.db; on Railway set to /data/pm.db (mounted volume)
DB_PATH=./data/pm.db

# ─── Railway-injected (auto, do not set locally) ──────────────────────────────
# RAILWAY_PUBLIC_DOMAIN=your-service.up.railway.app

# ─── Optional ────────────────────────────────────────────────────────────────
# On first deploy, scan last N days of inbox to backfill bank emails.
# Set to 0 / unset on subsequent deploys to skip.
EMAIL_BACKFILL_DAYS=90
